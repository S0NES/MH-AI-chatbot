{
  "id": "rise",
  "label": "Monster Hunter Rise",
  "data_dir": "rise",
  "examples": [
    "What is the best armor set I can make for bow, rank 3?",
    "What does Critical Eye do?",
    "Which armor has Weakness Exploit?",
    "Best great sword high rank",
    "Which decoration gives Attack Boost?"
  ],
  "scoring": {
    "_help": "How 'best build' is judged from the database's own skill texts: a skill scores when a description sentence has a positive verb and one of these keywords. Skills naming weapon types only count for those types, and a weapon type's `lacks` phrases exclude skills that depend on a mechanic it does not have. Remove this block to rank by defense only.",
    "keywords": {
      "attack power": 4.0,
      "attack": 3.0,
      "affinity": 2.5,
      "critical": 2.0,
      "damage": 2.0
    },
    "ignore_if_contains": [
      "damage taken",
      "element attack power",
      "buildup",
      "stun",
      "exhaust",
      "recovery",
      "bomb",
      "wirebug",
      "wirefall",
      "mount",
      "explosive"
    ],
    "weapon_specific_weight": 1.5,
    "positive_verbs": [
      "increase",
      "improve",
      "boost",
      "strengthen",
      "enhance",
      "extend"
    ]
  },
  "ranks": [
    {
      "id": "low",
      "label": "Low Rank",
      "hunter_rank": [
        1,
        4
      ],
      "aliases": [
        "low",
        "lr",
        "low rank",
        "novice"
      ]
    },
    {
      "id": "high",
      "label": "High Rank",
      "hunter_rank": [
        5,
        8
      ],
      "aliases": [
        "high",
        "high rank"
      ]
    },
    {
      "id": "master",
      "label": "Master Rank",
      "hunter_rank": [
        9,
        null
      ],
      "aliases": [
        "master",
        "mr",
        "master rank"
      ]
    }
  ],
  "part_order": [
    "head",
    "chest",
    "arms",
    "waist",
    "legs"
  ],
  "extras_label": "Rampage skills",
  "notes": [
    "The Rise dataset stores which skills each armor piece grants but not how many levels, so each listed skill counts as +1 level.",
    "Talismans/charms are not in the dataset, so builds do not include one.",
    "This dataset has Low Rank and High Rank only; Master Rank (the DLC rank) is not included."
  ],
  "ambiguous_skill_names": [
    "focus",
    "guard",
    "fortify",
    "constitution",
    "steadiness",
    "diversion",
    "heroics",
    "handicraft",
    "botanist",
    "geologist",
    "earplugs",
    "windproof",
    "artillery"
  ],
