  "tables": {
    "skills": {
      "file": "Skills.json",
      "records": "data",
      "dedupe_by": "name",
      "prefer_longest": "levels",
      "fields": {
        "name": "name",
        "description": "description",
        "levels": {
          "type": "keys_regex_list",
          "pattern": "lv\\d+"
        }
      }
    },
    "armors": {
      "file": "Armors.json",
      "records": "data",
      "fields": {
        "name": "name",
        "part": "part",
        "rank": {
          "path": "rank",
          "type": "enum",
          "map": {
            "0": "low",
            "1": "high"
          }
        },
        "rarity": {
          "path": "rare",
          "type": "int"
        },
        "defense": {
          "path": "defVal",
          "type": "int"
        },
        "res.fire": {
          "path": "fireRegVal",
          "type": "int"
        },
        "res.water": {
          "path": "waterRegVal",
          "type": "int"
        },
        "res.ice": {
          "path": "iceRegVal",
          "type": "int"
        },
        "res.thunder": {
          "path": "thunderRegVal",
          "type": "int"
        },
        "res.dragon": {
          "path": "dragonRegVal",
          "type": "int"
        },
        "slots": {
          "path": "decorationsNumList",
          "type": "json_int_list",
          "size": 3
        },
        "skills": {
          "path": "skills",
          "type": "name_levels",
          "name": "skill.name",
          "level": 1
        },
        "materials": {
          "path": "forging_materials",
          "type": "materials",
          "item": "item.name",
          "amount": "amount",
          "default": []
        },
        "set": "series"
      }
    },
    "decorations": {
      "file": "Decorations.json",
      "records": "data",
      "fields": {
        "name": "name",
        "size": {
          "path": "name",
          "type": "tail_int",
          "default": 1
        },
        "skills": {
          "path": "skills",
          "type": "name_levels",
          "name": "skill.name",
          "level": 1
        },
        "materials": {
          "path": "materials",
          "type": "materials",
          "item": "item.name",
          "amount": "amount",
          "default": []
        }
      }
    },
    "weapons": {
      "file": "Weapons.json",
      "records": "data",
      "fields": {
        "name": "name",
        "type": {
          "path": "weapon_type",
          "type": "weapon_type"
        },
        "rarity": {
          "path": "rareType",
          "type": "int"
        },
        "rank": {
          "path": "rareType",
          "type": "range_map",
          "ranges": {
            "low": [
              0,
              2
            ],
            "high": [
              3,
              6
            ]
          }
        },
        "attack": {
          "path": "atk",
          "type": "int"
        },
        "affinity": {
          "path": "criticalRate",
          "type": "int"
        },
        "defense_bonus": {
          "path": "defBonus",
          "type": "int"
        },
        "extras": {
          "path": "rampage_skills",
          "type": "list_str",
          "each": "skill.name",
          "default": []
        },
        "materials": {
          "path": "forging_materials",
          "type": "materials",
          "item": "item.name",
          "amount": "amount",
          "default": []
        }
      }
    },
    "items": {
      "file": "Items.json",
      "records": "data",
      "fields": {
        "name": "name",
        "description": "description",
        "buy": {
          "path": "buyPrice",
          "type": "int",
          "default": 0
        },
        "sell": {
          "path": "sellPrice",
          "type": "int",
          "default": 0
        }
      }
    }
  }
}
