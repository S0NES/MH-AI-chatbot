# Databases fetched at build time: <game-id>=<git-url>[#sub-folder], space separated
DATA_SOURCES=

# Language model pulled from Hugging Face at build time (any GGUF chat model)
MHBOT_MODEL_REPO=
MHBOT_MODEL_FILE=
MHBOT_MODEL_REVISION=

# Runtime settings for the model server
MHBOT_N_CTX=2048
MHBOT_N_THREADS=
MHBOT_N_GPU_LAYERS=0
MHBOT_CHAT_FORMAT=

# Seconds the web app waits for the model before falling back to the rules parser
LLM_TIMEOUT=90
WEB_PORT=8000
